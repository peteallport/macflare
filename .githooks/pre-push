#!/usr/bin/env bash
# Created by Peter C. Allport
# Inspect committed history as well as the index before uploading any refs.
set -euo pipefail
export GIT_OPTIONAL_LOCKS=0
check_dir="$(mktemp -d "${TMPDIR:-/tmp}/macflare-pre-push.XXXXXX")"
trap 'rm -rf -- "$check_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
git show HEAD:script/check-public-content.py > "$check_dir/check-public-content.py"
# Check every ref being uploaded, not unrelated local/retired branches.
received=0
while read -r local_ref local_oid remote_ref remote_oid; do
    received=1
    if [[ "$local_oid" =~ ^0+$ ]]; then
        continue # Deletion uploads no history.
    fi
    python3 "$check_dir/check-public-content.py" --history --revision "$local_oid"
done
if [[ "$received" == 0 ]]; then
    python3 "$check_dir/check-public-content.py" --history
fi
