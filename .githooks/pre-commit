#!/usr/bin/env bash
# Validate the active Git index without changing staged content or local signing edits.
set -euo pipefail
export GIT_OPTIONAL_LOCKS=0

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
check_dir="$(mktemp -d "${TMPDIR:-/tmp}/macflare-pre-commit.XXXXXX")"
trap 'rm -rf -- "$check_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# NUL-delimited paths handle whitespace and newlines. Deleting a signing artifact
# is allowed; renaming one into the commit is checked as an addition.
git diff --cached --name-only --no-renames --diff-filter=ACMT -z > "$check_dir/paths"
while IFS= read -r -d '' path; do
    case "$path" in
        *.[pP]12|*.[pP][fF][xX]|*.[mM][oO][bB][iI][lL][eE][pP][rR][oO][vV][iI][sS][iI][oO][nN]|*.[pP][rR][oO][vV][iI][sS][iI][oO][nN][pP][rR][oO][fF][iI][lL][eE])
            printf 'Commit blocked: staged signing artifact: %s\n' "$path" >&2
            exit 1
            ;;
    esac
done < "$check_dir/paths"

project='macflare.xcodeproj/project.pbxproj'
git diff --cached --name-only -z -- "$project" > "$check_dir/project-path"
if [ ! -s "$check_dir/project-path" ]; then
    echo 'No staged project changes; signing artifact checks passed.'
    exit 0
fi

# Read the mode and blob from the active index, including GIT_INDEX_FILE used by
# git commit. Never read or rewrite the working project or run git add/update-index.
entry="$(git ls-files --stage -- "$project")"
case "$entry" in
    100644\ *|100755\ *) ;;
    *)
        echo 'Commit blocked: staged project.pbxproj is missing or not a regular file.' >&2
        exit 1
        ;;
esac
for tool in plutil python3; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'Commit blocked: required tool %s is unavailable.\n' "$tool" >&2
        exit 1
    fi
done
git show ":$project" > "$check_dir/project.pbxproj"
if ! plutil -convert xml1 -o "$check_dir/project.plist" -- "$check_dir/project.pbxproj"; then
    echo 'Commit blocked: staged project.pbxproj failed plist syntax validation.' >&2
    exit 1
fi

# Parse the project, rather than matching text that can occur in comments or
# quoted scripts. Conditional keys such as DEVELOPMENT_TEAM[sdk=macosx*] count.
python3 - "$check_dir/project.plist" <<'PY'
import plistlib
import sys


def block(message):
    raise SystemExit('Commit blocked: ' + message)


with open(sys.argv[1], 'rb') as source:
    project = plistlib.load(source)
objects = project.get('objects')
if not isinstance(objects, dict) or project.get('rootObject') not in objects:
    block('staged project.pbxproj is missing a valid rootObject.')

signing_keys = {
    'DEVELOPMENT_TEAM', 'PROVISIONING_PROFILE',
    'PROVISIONING_PROFILE_SPECIFIER', 'CODE_SIGN_IDENTITY',
}
for identifier, item in objects.items():
    if not isinstance(item, dict):
        block('staged project.pbxproj contains an invalid project object.')
    settings = item.get('buildSettings', {})
    if not isinstance(settings, dict):
        block('staged project.pbxproj contains invalid buildSettings.')
    for key, value in settings.items():
        if key.split('[', 1)[0] in signing_keys and value != '':
            block(f'staged project contains nonempty {key}. '
                  'Keep personal signing settings in local build overrides; '
                  'stage the intended project settings explicitly.')

# A previous text-rewriting hook could collapse test bundle IDs into the app ID.
# Validate literal IDs across targets while preserving every staged byte.
owners = {}
for identifier, target in objects.items():
    if target.get('isa') != 'PBXNativeTarget':
        continue
    configuration_list = objects.get(target.get('buildConfigurationList'), {})
    for configuration_id in configuration_list.get('buildConfigurations', []):
        configuration = objects.get(configuration_id, {})
        for key, value in configuration.get('buildSettings', {}).items():
            if key.split('[', 1)[0] != 'PRODUCT_BUNDLE_IDENTIFIER' or not value:
                continue
            if not isinstance(value, str):
                block('staged project contains an invalid bundle identifier.')
            if '$' in value:
                continue  # Expanded build settings require Xcode to resolve.
            if value in owners and owners[value] != identifier:
                block('staged project shares a bundle identifier across targets. '
                      'Keep app and test bundle identifiers distinct.')
            owners[value] = identifier

print('Staged project checks passed; index and working tree preserved.')
PY
